{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Lab 2 OpenGL (g++)",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-O2",
                "-I${workspaceFolder}/src/Lab2",
                "${workspaceFolder}/src/Lab2/main.cpp",
                "${workspaceFolder}/src/Lab2/Window.cpp",
                "${workspaceFolder}/src/Lab2/Clipping.cpp",
                "${workspaceFolder}/src/Lab2/Filling.cpp",
                "-o",
                "${workspaceFolder}/bin/Lab2_OpenGL.exe",
                "-lopengl32",
                "-lglu32",
                "-lgdi32",
                "-luser32",
                "-Wl,--stack,67108864"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Bien dich Lab 2 (Xen hinh Cohen/Midpoint & To mau Boundary/Scanline)"
        },
